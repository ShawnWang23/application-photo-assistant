# Optional desktop-only defaults. Web deployments never expose or consume
# provider keys from environment variables; each Web user must supply their own.
# Never put real keys in source control.
# Use "web" on any shared/server deployment; desktop is for trusted local use only.
PHOTO_ASSISTANT_DEPLOYMENT=desktop
SILICONFLOW_API_KEY=your_api_key_here
OPENAI_API_KEY=your_api_key_here
DEEPSEEK_API_KEY=your_api_key_here
MOONSHOT_API_KEY=your_api_key_here
ARK_API_KEY=your_api_key_here
CUSTOM_LLM_API_KEY=your_api_key_here
